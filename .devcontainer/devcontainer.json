{
  "name": "aircloud-dotgithub",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/devcontainers/features/python:1": { "version": "3.12" },
    "ghcr.io/devcontainers/features/node:1": { "version": "20" },
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    "ghcr.io/devcontainers-extra/features/actionlint:1": {},
    "ghcr.io/devcontainers-extra/features/pre-commit:2": {},
    "ghcr.io/dhoeric/features/trivy:1": {},
    "ghcr.io/dhoeric/features/cosign:1": {}
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "github.vscode-github-actions",
        "redhat.vscode-yaml",
        "editorconfig.editorconfig",
        "esbenp.prettier-vscode",
        "davidanson.vscode-markdownlint",
        "github.copilot",
        "github.copilot-chat"
      ],
      "settings": {
        "files.eol": "\n",
        "editor.formatOnSave": true
      }
    }
  },
  "remoteUser": "vscode",
  "postCreateCommand": "pip install --user yamllint zizmor==1.0.0 && make setup || true",
  "postStartCommand": "git config --global commit.gpgsign true || true",
  "containerEnv": {
    "PIP_DISABLE_PIP_VERSION_CHECK": "1"
  }
}
